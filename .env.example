# --- Upstash Redis (create a free database at https://console.upstash.com) ---
# These are auto-injected if you use the Vercel Upstash integration/marketplace.
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token-here

# --- Server-side encryption secret ---
# Used to encrypt note content at rest when the creator does NOT set a private key.
# Generate one with: openssl rand -hex 32
SERVER_ENCRYPTION_KEY=replace-with-64-hex-char-random-string

# --- App config ---
NEXT_PUBLIC_APP_URL=https://levpriv.vercel.app

# --- Vercel Blob (for audio/video/photo/file attachments) ---
# Create a free Blob store from your Vercel dashboard -> Storage -> Create Database -> Blob.
# This is auto-injected as an environment variable once the store is connected to your project.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxx
