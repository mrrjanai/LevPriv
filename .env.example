# --- Upstash Redis (create a free database at https://console.upstash.com) ---
# These are auto-injected if you use the Vercel Upstash integration/marketplace.
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token-here

# --- Server-side encryption secret ---
# Used to encrypt note content at rest when the creator does NOT set a private key.
# Generate one with: openssl rand -hex 32
SERVER_ENCRYPTION_KEY=replace-with-64-hex-char-random-string

# --- App config ---
NEXT_PUBLIC_APP_URL=https://levpriv.vercel.app
